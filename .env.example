# Copy this file to .env and fill in your Supabase project values.
# Never commit .env — it is already covered by .gitignore.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# The anon key is safe for the frontend; it is subject to Row Level
# Security policies configured in Supabase. Never place a service-role
# key in frontend code or environment variables prefixed with VITE_.
